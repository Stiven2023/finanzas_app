# --- Python cache/bytecode ---
__pycache__/
*.py[cod]
*$py.class

# --- Virtual environments ---
.venv/
venv/
env/

# --- Build / packaging ---
build/
dist/
*.spec

# --- Installer / logs / runtime ---
*.log
pip-log.txt
pip-delete-this-directory.txt

# --- Testing / coverage ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# --- Type checking / linting caches ---
.mypy_cache/
.ruff_cache/
.pyre/

# --- Jupyter ---
.ipynb_checkpoints/

# --- IDE / editor ---
.vscode/
.idea/
*.swp
*.swo

# --- OS files ---
.DS_Store
Thumbs.db

# --- Local app data / databases ---
*.db
data/*.db

# --- Local secrets/config overrides ---
.env
.env.*
!.env.example

# --- Temporary files ---
*.tmp
*.temp
